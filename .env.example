# Maureen Ella environment variables - example only.
# Copy this file to .env.local for local development.
# Never commit real keys or secrets.

# Site
NEXT_PUBLIC_SITE_URL=https://maureenella.com
NEXT_PUBLIC_SITE_NAME="Maureen Ella"

# Analytics and search
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# Resend email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=inquiries@maureenella.com
FORM_TO_EMAIL=
RESEND_AUDIENCE_ID=

# CRM / automations
CRM_WEBHOOK_URL=
HONEYBOOK_API_KEY=
ZAPIER_WEBHOOK_URL=
MAKE_WEBHOOK_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=portfolio

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare Turnstile spam protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Cloudflare R2 image/media storage
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=

# Vercel deployment automation
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Affiliate / favorites
AFFILIATE_DISCLOSURE_ENABLED=true
AMAZON_ASSOCIATE_TAG=
LTK_PUBLISHER_ID=

# Optional social APIs
INSTAGRAM_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
