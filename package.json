{
  "name": "maureenella",
  "version": "0.1.0",
  "private": true,
  "description": "maureenella.com — premium bridal hair & makeup brand site",
  "engines": { "node": ">=22.16.0 <23" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "email": "email dev --dir emails --port 3001",
    "test": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"lib/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "motion": "^12.42.2",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@react-email/ui": "^6.9.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.5.28",
    "react-email": "^6.9.1",
    "tailwindcss": "^4.3.0",
    "typescript": "5.7.3"
  },
  "overrides": { "sharp": "$sharp" }
}
